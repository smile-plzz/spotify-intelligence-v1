# Spotify Intelligence — gitignore
# Environment / secrets
.env
# Virtual environment
.venv/
# Database (generated at runtime)
spotify_data.db
# Runtime artifacts
analytics_results.json
ngrok.log
# Python bytecode
__pycache__/
*.pyc
*.pyo
# OS files
.DS_Store
Thumbs.db
# IDE
.vscode/
.idea/
*.swp
*.swo
# Test artifacts
.pytest_cache/

# Runtime logs (not tracked)
dashboard.log
ngrok-live.log
